<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cocorra.DAL\Cocorra.DAL.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.5" />
    <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Livekit.Server.Sdk.Dotnet" Version="1.2.2" />
    <PackageReference Include="MediatR" Version="14.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- PushNotificationService's payload formatting runs after the Firebase-initialised
         guard, so it is unreachable from a unit test through the public method. Exposed to
         the test project rather than made public: it is not part of the service's contract. -->
    <InternalsVisibleTo Include="Cocorra.Tests" />
  </ItemGroup>

</Project>
