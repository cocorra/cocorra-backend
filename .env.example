# ============================================================================
# Cocorra API — production environment template
# ============================================================================
#
# Copy to `.env` next to docker-compose.yml and replace every CHANGE_ME:
#
#   cp .env.example .env
#   docker compose up -d
#
# `.env` is gitignored. THIS file is tracked, so it must only ever hold
# placeholders.
#
# How the values reach the API:
#   - docker-compose passes every line of `.env` into the container (env_file),
#     where ASP.NET Core reads `Section__Key` as configuration `Section:Key`.
#   - UPPER_CASE variables marked [compose-enforced] are mapped in
#     docker-compose.yml with `${VAR:?message}`; `docker compose up` aborts if
#     one is missing.
#   - [startup-enforced] values make the API throw at startup if they are
#     missing or still a placeholder.
#
# Quoting: Compose interpolates `$` in this file. If a value contains `$`, wrap
# it in single quotes: KEY='pa$$word'.
#
# Do not set ASPNETCORE_ENVIRONMENT / ASPNETCORE_URLS here; docker-compose.yml
# sets them. Production configuration lives ONLY here — never in
# appsettings.json (tracked) or appsettings.Production.json (excluded from the
# Docker build context).
#
# Also required on the server, but not an environment variable:
#   ./firebase-config.json — Firebase service-account key, mounted read-only.
#   Without it the API starts but every push notification is skipped.
# ============================================================================


# ── LOCAL DEVELOPMENT DOES NOT USE THIS FILE ────────────────────────────────
#
# For `dotnet run` / `dotnet watch run`, use user-secrets (stored outside the
# repository, loaded only in Development). The API refuses to start without:
#
#     dotnet user-secrets set "Analytics:IpHashSalt"   "$(openssl rand -base64 32)" --project Cocorra.API
#     dotnet user-secrets set "Otp:HmacKey"            "$(openssl rand -base64 32)" --project Cocorra.API
#     dotnet user-secrets set "JWTSetting:securityKey" "$(openssl rand -base64 48)" --project Cocorra.API
#     dotnet user-secrets set "SeedAdmin:Password"     "<a strong password>"        --project Cocorra.API
#
# The local connection string is in appsettings.Development.json.


# ════════════════════════════════════════════════════════════════════════════
#  1. REQUIRED — the API will not start without these
# ════════════════════════════════════════════════════════════════════════════

# Database connection string [compose-enforced]. appsettings.json has none, so
# without it migrations fail and the API exits. Inside Docker, address SQL
# Server by container name on cocorra-network — never by public IP, and never
# publish 1433 on the host (Docker bypasses UFW). Use a least-privilege login,
# not sa.
DB_CONNECTION_STRING=Server=cocorra_db,1433;Database=CocorraDb;User Id=cocorra_app;Password=CHANGE_ME_db_password;TrustServerCertificate=True;MultipleActiveResultSets=True;

# JWT signing key [compose-enforced] [startup-enforced]. Anyone holding it can
# forge tokens for any user, admins included. At least 32 characters.
# Rotating it signs every user out. Generate: openssl rand -base64 48
JWT_SECURITY_KEY=CHANGE_ME_run_openssl_rand_base64_48

# OTP code hashing key [compose-enforced] [startup-enforced]. Email OTP codes
# are stored only as HMAC-SHA256(key, code); without a secret key a leaked
# 6-digit hash is cracked instantly. At least 32 characters. Rotating is safe:
# only codes outstanding at that moment stop working.
# Generate: openssl rand -base64 32
OTP_HMAC_KEY=CHANGE_ME_run_openssl_rand_base64_32

# Analytics IP hash salt [compose-enforced] [startup-enforced].
# UserEvent.IpHash = SHA256(salt + ip); anyone holding the salt can reverse
# every stored hash by brute-forcing IPv4. Do not rotate casually: hashes from
# before and after a rotation cannot be correlated.
# See docs/dashboard-discovery/PRODUCTION-READINESS-REPORT.md section 2.
# Generate: openssl rand -base64 32
ANALYTICS_IP_HASH_SALT=CHANGE_ME_run_openssl_rand_base64_32

# Seed admin password [compose-enforced] [startup-enforced]. Used only when the
# admin account does not exist yet (empty database). Must satisfy the Identity
# password policy, or the first start fails creating the account.
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_unique_password


# ════════════════════════════════════════════════════════════════════════════
#  2. REQUIRED — the API starts, but a feature is broken without these
# ════════════════════════════════════════════════════════════════════════════

# Seed admin login. Unset falls back to admin@cocorraapp.local.
SeedAdmin__Email=admin@cocorraapp.com

# ── LiveKit (voice rooms) ───────────────────────────────────────────────────
# Mints room access tokens and calls the LiveKit server API. Must match the
# key/secret pair under `keys:` (and webhook.api_key) in the server's
# livekit/livekit.yaml. Unset: every token request and room creation fails.
LiveKit__ApiKey=CHANGE_ME_livekit_api_key
LiveKit__ApiSecret=CHANGE_ME_livekit_api_secret

# ── Transactional email (Resend) ────────────────────────────────────────────
# OTP, password-reset and admin notification mail. Unset: every send fails.
# Create a key with "Sending access" at https://resend.com/api-keys.
# (EmailSettings__ResendApiKey is also accepted and takes priority.)
RESEND_API_KEY=CHANGE_ME_resend_api_key

# ── Object storage (MinIO, S3-compatible) ───────────────────────────────────
# Profile/room images, support screenshots and voice recordings. Unset: the
# localhost placeholders from appsettings.json are used and every upload fails.
# Endpoint: inside Docker use the MinIO container name, never localhost or a
# public IP; do not publish 9000 on the host. http:// or https:// selects TLS.
Minio__Endpoint=http://minio:9000
# A MinIO user with read/write on the bucket (not the root user).
Minio__AccessKey=CHANGE_ME_minio_access_key
Minio__SecretKey=CHANGE_ME_minio_secret_key
# (MINIO_ENDPOINT, MINIO_ACCESS_KEY / MINIO_ROOT_USER, MINIO_SECRET_KEY /
# MINIO_ROOT_PASSWORD, MINIO_BUCKET_NAME and MINIO_PUBLIC_URL are also read and
# override the Minio__* values when set. Use one naming style, not both.)


# ════════════════════════════════════════════════════════════════════════════
#  3. RECOMMENDED
# ════════════════════════════════════════════════════════════════════════════

# Public base URL of this API. Prefixed onto legacy upload paths stored
# relative to wwwroot (e.g. "Uploads/img/...") in API responses and the JWT
# profilePicture claim. Unset, those come out as "/Uploads/..." and mobile
# clients cannot load them. Full storage URLs are returned unchanged either way.
AppSettings__BaseUrl=https://api.cocorraapp.com


# ════════════════════════════════════════════════════════════════════════════
#  4. OPTIONAL — appsettings.json defaults (shown) are correct for production
# ════════════════════════════════════════════════════════════════════════════

# ── Object storage ──────────────────────────────────────────────────────────
# Bucket name (must already exist; the API does not create it).
# Minio__BucketName=cocorra-assets
# Public base URL that stored-file links are built from: {PublicUrl}/{bucket}/{key}.
# Minio__PublicUrl=https://storage.cocorraapp.com

# ── Email ───────────────────────────────────────────────────────────────────
# Sender; MUST be on a domain verified in Resend.
# EmailSettings__FromEmail=support@cocorraapp.com
# EmailSettings__FromName=Cocorra Support
# Logo shown in email templates.
# EmailSettings__LogoUrl=https://admin.cocorraapp.com/cocorra-logo.jpg

# ── LiveKit ─────────────────────────────────────────────────────────────────
# WebSocket URL clients connect to.
# LiveKit__ServerUrl=wss://live.cocorraapp.com
# Token lifetime = reconnection window after joining (see LiveKitSettings.cs).
# LiveKit__TokenTtlMinutes=240
# How long LiveKit keeps an empty room; must exceed the longest bookable room.
# LiveKit__RoomEmptyTimeoutMinutes=240

# ── JWT ─────────────────────────────────────────────────────────────────────
# Changing either invalidates every issued token.
# JWTSetting__ValidIssuer=https://api.cocorraapp.com
# JWTSetting__ValidAudience=CocorraMobileApp

# ── CORS ────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API with credentials. One index per entry;
# setting an index replaces that index of the default list.
# Cors__AllowedOrigins__0=https://admin.cocorraapp.com
# Cors__AllowedOrigins__1=https://api.cocorraapp.com

# ── Reverse proxy / forwarded headers ───────────────────────────────────────
# X-Forwarded-For / -Proto are honoured ONLY from these proxies, so per-IP rate
# limiting sees the real client. Defaults: 127.0.0.1, ::1, 127.0.0.0/8 and
# 172.16.0.0/12 (the default Docker bridges). Set the proxy's real address if
# it differs; never trust everything.
# ForwardedHeaders__KnownProxies__0=172.18.0.1
# ForwardedHeaders__KnownNetworks__0=172.16.0.0/12

# ── Room invites ────────────────────────────────────────────────────────────
# Invite links are {PublicBaseUrl}/invite/{code}.
# Invites__PublicBaseUrl=https://cocorraapp.com
# Invites__DefaultLifetimeHours=24
# Invites__MaxLifetimeHours=168
# Invites__MaxActivePerInviterPerRoom=20

# ── Room lifecycle ──────────────────────────────────────────────────────────
# How long a Live room waits for a disconnected host before closing.
# RoomLifecycle__HostReconnectGraceSeconds=90
# RoomLifecycle__GraceSweepIntervalSeconds=10
# Extra time past the booked duration before a room is ended.
# RoomLifecycle__RoomOvertimeGraceMinutes=15
# RoomLifecycle__DurationSweepIntervalSeconds=60

# ── System logs (Admin > System Logs) ───────────────────────────────────────
# SystemLogs__Enabled=true
# SystemLogs__MinimumLevel=Warning
# SystemLogs__RetentionDays=30
# SystemLogs__QueueCapacity=5000
# SystemLogs__BatchSize=100

# ── Analytics staged activation ─────────────────────────────────────────────
# Leave unset for the initial deployment (both flags default to false). Enable
# ONE AT A TIME, only after the matching gate in
# docs/dashboard-discovery/30-production-deployment-checklist.md has passed.
# EnableHighFrequencyEvents does nothing unless EnableNewEventEmission is true.
#
# Stage B — low-frequency core-loop events:
# Analytics__EnableNewEventEmission=true
#
# Stage C — high-frequency events. Raise the channel capacity in a SEPARATE,
# EARLIER deploy so a drop-rate spike can be attributed to one change or the other.
# Analytics__EventChannelCapacity=25000
# Analytics__EnableHighFrequencyEvents=true

# ── Analytics pipeline tuning ───────────────────────────────────────────────
# Analytics__EventFlushBatchSize=100
# Analytics__EventFlushMaxRetries=3
# Analytics__EventFlushInitialBackoffMs=200
# Analytics__RawEventRetentionDays=180
# Analytics__CleanupBatchSize=5000
# Analytics__AggregationIntervalMinutes=60
# Analytics__AggregationBatchSize=50000
# Analytics__AggregationTrailingDays=45

# Durable structured log sink. Must be a path on a mounted volume, or it is
# lost on container restart. Unset keeps stdout-only logging.
# Analytics__StructuredLogPath=/app/logs/cocorra-structured.log
# Analytics__StructuredLogMinimumLevel=Warning
