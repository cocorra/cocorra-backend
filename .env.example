# ============================================================================
# Cocorra — deployment secrets template
# ============================================================================
#
# Copy this file to `.env` next to docker-compose.yml and fill in real values.
# `.env` is gitignored. THIS file is tracked, so it must never contain a real
# value — only placeholders.
#
#   cp .env.example .env
#   # edit .env — replace every CHANGE_ME
#   docker compose up -d
#
# docker-compose passes every line of `.env` into the container (env_file) and
# also uses it for ${VAR} substitution in docker-compose.yml. Variables marked
# [compose-enforced] use the `${VAR:?message}` form, so `docker compose up`
# aborts if they are missing. Variables marked [startup-enforced] make the API
# throw at startup if they are missing or still a placeholder.
#
# Production configuration lives ONLY here. Do not reintroduce secrets into
# appsettings.json (tracked by git) or appsettings.Production.json (excluded
# from the Docker build context).
# ============================================================================


# ── LOCAL DEVELOPMENT DOES NOT USE THIS FILE ────────────────────────────────
#
# For `dotnet run` / `dotnet watch run`, use user-secrets instead. They are
# stored outside the repository and load only when ASPNETCORE_ENVIRONMENT is
# Development (set by launchSettings.json). The API refuses to start without
# these four:
#
#     dotnet user-secrets set "Analytics:IpHashSalt"   "$(openssl rand -base64 32)" --project Cocorra.API
#     dotnet user-secrets set "Otp:HmacKey"            "$(openssl rand -base64 32)" --project Cocorra.API
#     dotnet user-secrets set "JWTSetting:securityKey" "$(openssl rand -base64 48)" --project Cocorra.API
#     dotnet user-secrets set "SeedAdmin:Password"     "<a strong password>"        --project Cocorra.API


# ════════════════════════════════════════════════════════════════════════════
#  REQUIRED
# ════════════════════════════════════════════════════════════════════════════

# ── Analytics IP hash salt [compose-enforced] [startup-enforced] ────────────
# Salt for pseudonymising IP addresses: UserEvent.IpHash = SHA256(salt + ip).
# Anyone holding the salt can hash the whole IPv4 space and reverse every
# stored hash, so it must stay secret. Do not rotate casually: hashes written
# before and after a rotation cannot be correlated.
# See docs/dashboard-discovery/PRODUCTION-READINESS-REPORT.md section 2.
# Generate: openssl rand -base64 32
ANALYTICS_IP_HASH_SALT=CHANGE_ME_run_openssl_rand_base64_32

# ── OTP code hashing key [compose-enforced] [startup-enforced] ──────────────
# Email OTP codes are stored only as HMAC-SHA256(key, code). Without a secret
# key a leaked 6-digit hash is cracked instantly. Minimum 32 characters.
# Rotating is safe: only codes outstanding at that moment stop working.
# Generate: openssl rand -base64 32
OTP_HMAC_KEY=CHANGE_ME_run_openssl_rand_base64_32

# ── JWT signing key [compose-enforced] [startup-enforced] ───────────────────
# Signs every access token; anyone holding it can forge tokens for any user,
# admins included. Minimum 32 characters. Rotating it signs every user out.
# Generate: openssl rand -base64 48
JWT_SECURITY_KEY=CHANGE_ME_run_openssl_rand_base64_48

# ── Seed admin account ──────────────────────────────────────────────────────
# IdentitySeeder creates this admin on an empty database. Has no effect once
# the account exists; change the password from the dashboard after first login.
# Email: the admin login. Unset falls back to admin@cocorraapp.local.
SeedAdmin__Email=admin@cocorraapp.com
# Password [compose-enforced] [startup-enforced]: must satisfy the Identity
# password policy, or the first start fails creating the account.
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_unique_password

# ── Database ────────────────────────────────────────────────────────────────
# SQL Server connection string. Unset falls back to the localhost development
# database in appsettings.json, which does not exist inside the container, so
# migrations fail and the API exits at startup.
# Inside Docker, address the database by container name on cocorra-network —
# never by public IP, and never publish 1433 on the host (Docker bypasses UFW).
# Use a dedicated least-privilege login, not sa.
ConnectionStrings__DefaultConnection=Server=cocorra_db,1433;Database=CocorraDb;User Id=cocorra_app;Password=CHANGE_ME_db_password;TrustServerCertificate=True;MultipleActiveResultSets=True;

# ── LiveKit server credentials ──────────────────────────────────────────────
# Used to mint room access tokens and call the LiveKit server API. Must match a
# key/secret pair under `keys:` in the LiveKit server's livekit.yaml. Unset
# means every token request and room creation fails at runtime (no startup check).
LiveKit__ApiKey=CHANGE_ME_livekit_api_key
LiveKit__ApiSecret=CHANGE_ME_livekit_api_secret

# ── Transactional email (Resend) ────────────────────────────────────────────
# OTP, password-reset and admin notification mail. Read at send time, so the
# app starts without it, but every email send fails until it is set.
# Create a key with "Sending access" at https://resend.com/api-keys.
# (EmailSettings__ResendApiKey is also accepted and takes priority.)
RESEND_API_KEY=CHANGE_ME_resend_api_key

# ── MinIO object storage ────────────────────────────────────────────────────
# Stores uploaded images and voice files. Unset keeps the localhost/dev
# placeholders from appsettings.json and every upload fails.
# Endpoint: inside Docker use the MinIO container name (e.g. http://minio:9000),
# never localhost and never a public IP; do not publish 9000 on the host.
Minio__Endpoint=http://minio:9000
# Access key / secret key: a MinIO user with read/write on the bucket.
Minio__AccessKey=CHANGE_ME_minio_access_key
Minio__SecretKey=CHANGE_ME_minio_secret_key


# ════════════════════════════════════════════════════════════════════════════
#  OPTIONAL — defaults in appsettings.json are correct for production
# ════════════════════════════════════════════════════════════════════════════

# MinIO bucket name. Default: cocorra-assets
# Minio__BucketName=cocorra-assets

# Public base URL that stored-file links are built from. Default: https://storage.cocorraapp.com
# Minio__PublicUrl=https://storage.cocorraapp.com

# Sender identity. MUST be on a domain verified in Resend. Default: Cocorra Support <support@cocorraapp.com>
# EmailSettings__FromEmail=support@cocorraapp.com
# EmailSettings__FromName=Cocorra Support

# ── Reverse proxy / forwarded headers ───────────────────────────────────────
# X-Forwarded-For / X-Forwarded-Proto are honoured ONLY from these proxies, so
# per-IP rate limiting sees the real client behind the reverse proxy. Defaults:
# 127.0.0.1, ::1 and the 127.0.0.0/8 + 172.16.0.0/12 networks (which cover the
# default Docker bridges). Set the proxy's actual address if it differs; never
# trust everything. One index per entry; setting index 0 replaces the default
# at index 0.
# ForwardedHeaders__KnownProxies__0=172.18.0.1
# ForwardedHeaders__KnownNetworks__0=172.16.0.0/12

# ── Analytics staged activation ─────────────────────────────────────────────
# Leave unset for the initial deployment (both flags default to false). Enable
# ONE AT A TIME, only after the matching gate in
# docs/dashboard-discovery/30-production-deployment-checklist.md has passed.
# EnableHighFrequencyEvents does nothing unless EnableNewEventEmission is true.
#
# Stage B — low-frequency core-loop events:
# Analytics__EnableNewEventEmission=true
#
# Stage C — high-frequency events. Raise the channel capacity in a SEPARATE,
# EARLIER deploy so a drop-rate spike can be attributed to one change or the other.
# Analytics__EventChannelCapacity=25000
# Analytics__EnableHighFrequencyEvents=true

# Durable structured log sink. Must point at a mounted volume path, or it is
# lost on container restart. Unset keeps stdout-only logging.
# Analytics__StructuredLogPath=/app/logs/cocorra-structured.log
