# Build and object folders
bin/
obj/

# Publish output. Was NOT ignored, and 170 files of it were committed under
# Cocorra.API/publish/ — nested six deep, including six duplicate copies of
# appsettings.json with every production secret in them.
publish/
Cocorra.API/publish/

# Visual Studio hidden folder
.vs/

# User-specific files
*.user
*.suo

# OS generated files
.DS_Store
Thumbs.db

# Scratch
implementation_plan.md

# ── Secrets ─────────────────────────────────────────────────────────────────

# Deployment secrets for docker-compose. Copy .env.example to .env and fill it
# in; .env must never be committed. .env.example is tracked and holds only
# placeholders.
.env
.env.*
!.env.example

firebase-config.json
Cocorra.API/firebase-config.json

# WebDeploy publish profiles embed the hosting password in a userPWD attribute.
*.publishSettings

# NOTE: the three rules below do NOT protect Cocorra.API/appsettings.json or
# Cocorra.API/appsettings.Development.json. Both were committed BEFORE these
# rules existed, and .gitignore has no effect on an already-tracked file — so
# every edit to them is still versioned. The rules only stop NEW copies (for
# example a generated appsettings.Production.json) from being added.
#
# appsettings.json still holds live secrets and is still tracked. See
# docs/dashboard-discovery/PRODUCTION-READINESS-REPORT.md section 2 for the
# inventory, severities and rotation runbook.
**/appsettings.json
**/appsettings.Production.json
**/appsettings.Development.json

# Real LiveKit server config (holds the API secret). Track only livekit/livekit.example.yaml.
livekit/livekit.yaml
